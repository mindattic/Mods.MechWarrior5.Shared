<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MechWarrior5.Shared.Wpf.Converters">
    <!-- Merge this one dictionary in App.xaml; ThemeManager swaps the palette (first entry) at runtime. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MechWarrior5.Shared.Wpf;component/Theme/Palette.Mercs.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MechWarrior5.Shared.Wpf;component/Theme/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:StandingToWidthConverter x:Key="StandingToWidth" />
</ResourceDictionary>
