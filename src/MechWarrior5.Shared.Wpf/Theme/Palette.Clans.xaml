<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CLANS: MW5 Clans palette - cold steel panels, ice-cyan accents, white readouts. -->
    <Color x:Key="Color.Void">#FF05080C</Color>
    <Color x:Key="Color.Base">#FF0A0F15</Color>
    <Color x:Key="Color.Panel">#FF101822</Color>
    <Color x:Key="Color.PanelRaised">#FF17222E</Color>
    <Color x:Key="Color.Line">#FF223244</Color>
    <Color x:Key="Color.LineBright">#FF35506A</Color>
    <Color x:Key="Color.Accent">#FF4FD1E8</Color>
    <Color x:Key="Color.AccentHot">#FFA6F2FF</Color>
    <Color x:Key="Color.AccentDim">#FF1F6676</Color>
    <Color x:Key="Color.Text">#FFE9F3F8</Color>
    <Color x:Key="Color.TextMuted">#FF8FA4B5</Color>
    <Color x:Key="Color.TextFaint">#FF526577</Color>
    <Color x:Key="Color.Danger">#FFFF5A4E</Color>
    <Color x:Key="Color.Ok">#FF7FD48B</Color>
    <Color x:Key="Color.Info">#FFB79CFF</Color>

    <SolidColorBrush x:Key="Brush.Void" Color="{StaticResource Color.Void}" />
    <SolidColorBrush x:Key="Brush.Base" Color="{StaticResource Color.Base}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineBright" Color="{StaticResource Color.LineBright}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHot" Color="{StaticResource Color.AccentHot}" />
    <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.AccentDim}" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#224FD1E8" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerWash" Color="#22E4573D" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.OkWash" Color="#2286C25B" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <LinearGradientBrush x:Key="Brush.PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF142130" />
        <GradientStop Offset="1" Color="#FF0C131B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF182634" />
        <GradientStop Offset="0.6" Color="#FF0F1823" />
        <GradientStop Offset="1" Color="#FF0A0F15" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF7FE3F2" />
        <GradientStop Offset="1" Color="#FF2FB3CC" />
    </LinearGradientBrush>

    <!-- Faint tactical grid laid under every page. -->
    <DrawingBrush x:Key="Brush.Grid" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Opacity="0.35">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF15263A" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
