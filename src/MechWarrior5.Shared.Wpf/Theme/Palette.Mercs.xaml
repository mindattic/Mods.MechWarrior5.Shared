<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MERCS: MW5 Mercenaries HUD palette - gunmetal panels, amber command accents, white readouts. -->
    <Color x:Key="Color.Void">#FF07090B</Color>
    <Color x:Key="Color.Base">#FF0C1014</Color>
    <Color x:Key="Color.Panel">#FF12181E</Color>
    <Color x:Key="Color.PanelRaised">#FF19212A</Color>
    <Color x:Key="Color.Line">#FF27323D</Color>
    <Color x:Key="Color.LineBright">#FF3A4856</Color>
    <Color x:Key="Color.Accent">#FFF2A51A</Color>
    <Color x:Key="Color.AccentHot">#FFFFC24A</Color>
    <Color x:Key="Color.AccentDim">#FF7A5410</Color>
    <Color x:Key="Color.Text">#FFE8EAEC</Color>
    <Color x:Key="Color.TextMuted">#FF8D99A5</Color>
    <Color x:Key="Color.TextFaint">#FF56626E</Color>
    <Color x:Key="Color.Danger">#FFE4573D</Color>
    <Color x:Key="Color.Ok">#FF86C25B</Color>
    <Color x:Key="Color.Info">#FF4FB3D9</Color>

    <SolidColorBrush x:Key="Brush.Void" Color="{StaticResource Color.Void}" />
    <SolidColorBrush x:Key="Brush.Base" Color="{StaticResource Color.Base}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineBright" Color="{StaticResource Color.LineBright}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHot" Color="{StaticResource Color.AccentHot}" />
    <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.AccentDim}" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#22F2A51A" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerWash" Color="#22E4573D" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.OkWash" Color="#2286C25B" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <LinearGradientBrush x:Key="Brush.PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF161D24" />
        <GradientStop Offset="1" Color="#FF0F1419" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF1B232C" />
        <GradientStop Offset="0.6" Color="#FF10161C" />
        <GradientStop Offset="1" Color="#FF0C1014" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFB933" />
        <GradientStop Offset="1" Color="#FFE08E0B" />
    </LinearGradientBrush>

    <!-- Faint tactical grid laid under every page. -->
    <DrawingBrush x:Key="Brush.Grid" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Opacity="0.35">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF16202A" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
