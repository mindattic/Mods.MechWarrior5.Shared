<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Mech5.Shared.Wpf.Converters">
    <!-- Merge this one dictionary in App.xaml to get the whole MW5 HUD look. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mech5.Shared.Wpf;component/Theme/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:StandingToWidthConverter x:Key="StandingToWidth" />
</ResourceDictionary>
