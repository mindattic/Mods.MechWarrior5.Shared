<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MW5 Mercenaries HUD palette: gunmetal panels, amber command accents, white readouts. -->
    <Color x:Key="Color.Void">#FF07090B</Color>
    <Color x:Key="Color.Base">#FF0C1014</Color>
    <Color x:Key="Color.Panel">#FF12181E</Color>
    <Color x:Key="Color.PanelRaised">#FF19212A</Color>
    <Color x:Key="Color.Line">#FF27323D</Color>
    <Color x:Key="Color.LineBright">#FF3A4856</Color>
    <Color x:Key="Color.Amber">#FFF2A51A</Color>
    <Color x:Key="Color.AmberHot">#FFFFC24A</Color>
    <Color x:Key="Color.AmberDim">#FF7A5410</Color>
    <Color x:Key="Color.Text">#FFE8EAEC</Color>
    <Color x:Key="Color.TextMuted">#FF8D99A5</Color>
    <Color x:Key="Color.TextFaint">#FF56626E</Color>
    <Color x:Key="Color.Danger">#FFE4573D</Color>
    <Color x:Key="Color.Ok">#FF86C25B</Color>
    <Color x:Key="Color.Info">#FF4FB3D9</Color>

    <SolidColorBrush x:Key="Brush.Void" Color="{StaticResource Color.Void}" />
    <SolidColorBrush x:Key="Brush.Base" Color="{StaticResource Color.Base}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineBright" Color="{StaticResource Color.LineBright}" />
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}" />
    <SolidColorBrush x:Key="Brush.AmberHot" Color="{StaticResource Color.AmberHot}" />
    <SolidColorBrush x:Key="Brush.AmberDim" Color="{StaticResource Color.AmberDim}" />
    <SolidColorBrush x:Key="Brush.AmberWash" Color="#22F2A51A" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerWash" Color="#22E4573D" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.OkWash" Color="#2286C25B" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <LinearGradientBrush x:Key="Brush.PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF161D24" />
        <GradientStop Offset="1" Color="#FF0F1419" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF1B232C" />
        <GradientStop Offset="0.6" Color="#FF10161C" />
        <GradientStop Offset="1" Color="#FF0C1014" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AmberGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFB933" />
        <GradientStop Offset="1" Color="#FFE08E0B" />
    </LinearGradientBrush>

    <!-- Faint tactical grid laid under every page. -->
    <DrawingBrush x:Key="Brush.Grid" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Opacity="0.35">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF16202A" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="Font.Hud">pack://application:,,,/Mech5.Shared.Wpf;component/Assets/Fonts/#Rajdhani</FontFamily>

    <!-- Geometry glyphs (no icon font dependency). -->
    <Geometry x:Key="Glyph.Company">M2,14 L8,2 L14,14 Z M8,6 L5,12 L11,12 Z</Geometry>
    <Geometry x:Key="Glyph.Mech">M5,1 H11 V4 H13 V8 H11 V10 L13,15 H10 L8,11 L6,15 H3 L5,10 V8 H3 V4 H5 Z</Geometry>
    <Geometry x:Key="Glyph.Inventory">M1,4 L8,1 L15,4 V12 L8,15 L1,12 Z M1,4 L8,7 L15,4 M8,7 V15</Geometry>
    <Geometry x:Key="Glyph.Pilot">M8,1 A3.5,3.5 0 1 1 7.99,1 Z M2,15 C2,10 5,8.5 8,8.5 C11,8.5 14,10 14,15 Z</Geometry>
    <Geometry x:Key="Glyph.Faction">M3,1 V15 M3,2 H13 L10.5,5.5 L13,9 H3</Geometry>
    <Geometry x:Key="Glyph.Open">M1,3 H6 L8,5 H15 V14 H1 Z</Geometry>
    <Geometry x:Key="Glyph.Save">M2,1 H12 L15,4 V15 H1 V1 Z M4,1 V5 H11 V1 M4,9 H12 V15 H4 Z</Geometry>
    <Geometry x:Key="Glyph.Search">M6.5,1 A5.5,5.5 0 1 1 6.49,1 Z M10.5,10.5 L15,15</Geometry>
    <Geometry x:Key="Glyph.Check">M2,8 L6,12 L14,3</Geometry>
    <Geometry x:Key="Glyph.Close">M2,2 L14,14 M14,2 L2,14</Geometry>
    <Geometry x:Key="Glyph.Minimize">M2,12 H14</Geometry>
    <Geometry x:Key="Glyph.Maximize">M2,2 H14 V14 H2 Z</Geometry>
    <Geometry x:Key="Glyph.Repair">M10,1 A4,4 0 0 0 6,6 L1,11 L1,14 L4,14 L9,9 A4,4 0 0 0 14,4 L11,6 L9,5 L9.5,2 Z</Geometry>
    <Geometry x:Key="Glyph.Trash">M2,4 H14 M6,4 V2 H10 V4 M3.5,4 L4.5,15 H11.5 L12.5,4</Geometry>
    <Geometry x:Key="Glyph.Reset">M3,8 A5,5 0 1 0 5,4 M5,1 V4.5 H1.5</Geometry>
    <Geometry x:Key="Glyph.Plus">M8,2 V14 M2,8 H14</Geometry>
    <Geometry x:Key="Glyph.Snowflake">M8,1 V15 M2,4.5 L14,11.5 M2,11.5 L14,4.5 M6,2 L8,4 L10,2 M6,14 L8,12 L10,14</Geometry>
    <Geometry x:Key="Glyph.Link">M6,10 L10,6 M7,4 L9,2 A3,3 0 0 1 14,7 L12,9 M9,12 L7,14 A3,3 0 0 1 2,9 L4,7</Geometry>
</ResourceDictionary>
