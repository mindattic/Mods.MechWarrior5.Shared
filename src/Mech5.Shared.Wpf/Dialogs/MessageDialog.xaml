<Window x:Class="Mech5.Shared.Wpf.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{Binding Title}">
    <c:ChamferBorder Style="{StaticResource Panel}" Chamfer="18" Padding="26,20,26,22"
                     Background="{DynamicResource Brush.Panel}" BorderBrush="{Binding ToneBrush}" BorderThickness="1.5"
                     AccentBrush="{Binding ToneBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Rectangle Width="6" Height="22" Fill="{Binding ToneBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="24" />
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="{Binding Message}" TextWrapping="Wrap" FontSize="16"
                       Foreground="{DynamicResource Brush.Text}" />

            <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Header}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="14" />
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Rectangle Width="4" Height="4" Fill="{Binding DataContext.Brush, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                           Margin="2,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{Binding TertiaryText}" Visibility="{Binding TertiaryVisibility}" Click="OnTertiary"
                        Style="{StaticResource Button.Danger}" Margin="0,0,10,0" MinWidth="110" />
                <Button Content="{Binding SecondaryText}" Visibility="{Binding SecondaryVisibility}" Click="OnSecondary"
                        IsCancel="True" Margin="0,0,10,0" MinWidth="110" />
                <Button Content="{Binding PrimaryText}" Click="OnPrimary" IsDefault="True"
                        Style="{StaticResource Button.Command}" MinWidth="120" />
            </StackPanel>
        </Grid>
    </c:ChamferBorder>
</Window>
