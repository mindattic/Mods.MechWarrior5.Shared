<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Local source is optional: the maintainer's pre-publish feed for MindAttic.* packages. If
      C:\LocalNuGet doesn't exist on your machine that's fine; NuGet ignores missing local sources.
    -->
    <add key="local" value="C:\LocalNuGet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
